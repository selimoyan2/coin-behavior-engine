  "regime_classifier_audit": {
    "investigation_id": "AUDIT-REGIME-LOCK-1001",
    "reported_behavior": "100% of live production predictions (4,308/4,308) classified as DELEVERAGING_STRESS.",
    "proven_root_cause": "STRUCTURAL_SINGLE_ROW_PERCENTILE_COLLAPSE_BUG",
    "code_location": "src/coin_behavior_engine/market_state/engine.py:370-393",
    "mathematical_mechanism": "Evaluating a single-row DataFrame in `UnifiedMarketStateEngine.predict_bar()` causes `np.nanpercentile([x], 5) == x`, making `oi_chg <= oi_drop_p05` identically True for any scalar input. Because `cond_delev` was the first rule in `np.select(conditions, choices)`, the classifier short-circuited immediately on condition 1, assigning MarketStateId.DELEVERAGING_STRESS to 100.0% of single-bar live predictions.",
