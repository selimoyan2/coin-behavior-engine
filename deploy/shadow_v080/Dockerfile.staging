# ==============================================================================
# SPRINT 09.12 / APPROVAL 1 — DOCKERFILE FOR OFFLINE LINUX STAGING BENCHMARK
# ==============================================================================
# Builds minimal, non-root, self-contained container for offline staging benchmark.
# No network access required at runtime (offline fixture execution only).
# ==============================================================================

FROM python:3.11-slim

WORKDIR /app

# Create unprivileged user (1000:1000)
RUN groupadd -g 1000 cbe && \
    useradd -u 1000 -g cbe -s /bin/sh -m cbe

# Install minimal scientific dependencies
RUN pip install --no-cache-dir joblib scikit-learn pandas numpy

# Copy application source, frozen model components, and inert entrypoint
COPY src/ /app/src/
COPY data/models/ /app/data/models/
COPY deploy/shadow_v080/entrypoint_inert.sh /app/entrypoint_inert.sh

# Prepare dedicated data directory with correct ownership
RUN mkdir -p /app/data/prospective_shadow && \
    chmod +x /app/entrypoint_inert.sh && \
    chown -R cbe:cbe /app

USER 1000:1000

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV CBE_ENV=staging_coolify_inert
ENV CBE_TRADING_DISABLED=true
ENV CBE_PROSPECTIVE_OBSERVATION_ENABLED=false
ENV CBE_BINANCE_COLLECTION_ENABLED=false
ENV CBE_RECORD_LABEL=WARMUP_REPLAY
ENV CBE_ENFORCE_PROSPECTIVE_GUARD=true
ENV CBE_SHADOW_DATA_DIR=/app/data/prospective_shadow

# SAFE BY DEFAULT: An accidental invocation without Compose or arguments runs the inert verification and exits 0.
# The Approval 1 benchmark workflow is preserved by explicitly passing the benchmark command:
#   python3 -m coin_behavior_engine.shadow_v080.benchmark_staging_linux
CMD ["/app/entrypoint_inert.sh"]
